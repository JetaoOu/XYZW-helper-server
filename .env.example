# 监听端口
PORT=3000

# 数据库文件路径（容器内默认 /app/data/xyzw.db）
DATABASE_PATH=./data/xyzw.db

# 管理员初始化账号（仅在数据库还没有用户时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 凭据加密密钥（32 字节，可用 `openssl rand -hex 32` 生成）
# 丢失此密钥将无法解密已保存的游戏凭据
CREDENTIAL_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 会话有效期（天）
SESSION_DAYS=30
